#!/usr/bin/env sh
# Lanzador local de Duplix. TODO queda dentro de esta carpeta (cwd y datos).
#   ./start         -> organiza ./input
#   ./start --menu  -> menú interactivo
#   ./start undo | ./start clean
set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"
BIN="$DIR/dist/duplix-linux-x86_64"

if [ ! -x "$BIN" ]; then
    echo "· compilando (solo la primera vez)…"
    ( cd "$DIR" && cargo build --release )
    mkdir -p "$DIR/dist"
    cp "$DIR/target/release/duplix" "$BIN"
fi

# Aísla los datos de la app en esta carpeta: nada fuera de local.
DUPLIX_HOME="$DIR"
export DUPLIX_HOME
cd "$DIR"
exec "$BIN" "$@"
